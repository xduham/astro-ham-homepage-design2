---
import CapsuleButton from "../CapsuleButton.astro";
import logo from "../../assets/LOGO.png";

const {hidetext} = Astro.props;
---
<header
        id="main-header"
        class="sticky top-0 z-50 w-full bg-[#FCFCFC]/80 dark:bg-[#121212]/80 backdrop-blur-sm"
>
    <div class="flex justify-between items-center-safe px-10 md:px-24 py-2">
        <a href="/" class="flex items-center space-x-3">
            <img src={logo.src} alt="Logo" class="w-12 h-12 dark:invert"/>
            <span class="text-lg font-semibold text-primary-500 hidden sm:inline">经验分享站</span>
        </a>

        {!hidetext && (
            <div class="space-x-10 font-semibold text-primary-500 hidden md:flex">
                <a class="hover:underline underline-offset-2" href="/blogs">文章列表</a>
                <a class="hover:underline underline-offset-2" href="/">首页</a>
            </div>
        )}

        <div>
            <CapsuleButton target="/blogs" >
                <div class="flex space-x-2">
                    <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5A1.5 1.5 0 0 1 5 20.5a1.5 1.5 0 0 1 1.5-1.5H20'/><path d='M8 7h6'/><path d='M8 11h8'/><path d='M8 15h6'/></svg>
                    <p>阅读文章</p>
                </div>
            </CapsuleButton>
        </div>
    </div>
</header>

<script>
const header = document.getElementById('main-header');

if (!header) {
    throw new Error('Header element not found');
}

window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
        header.classList.add('border-b', 'border-secondary-400');
    } else {
        header.classList.remove('border-b', 'border-secondary-400');
    }
});
</script>
