---
import Layout from "../layouts/Layout.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
---

<Layout title="文章列表 - 个人经验分享站">
    <div class="flex flex-col justify-between items-center mt-20 w-full">
        <p class="font-bold text-4xl mb-4">
            文章列表
        </p>
        <p class="text-secondary-600 mb-10">
            记录学习与探索的点滴
        </p>

        <ul class="flex flex-col justify-center items-center w-full space-y-6">
            {allPosts.map((post: any) => (
                <li class="posts w-full max-w-2xl">
                    <a class="text-2xl font-semibold hover:underline underline-offset-2" href={post.url}>
                        {post.frontmatter.title}
                    </a>
                    <p class="text-secondary-600 text-sm mt-1">
                        {post.frontmatter.pubDate?.slice(0, 10)}
                    </p>
                    <p class="font-normal text-sm text-secondary-600 mt-3 leading-relaxed">
                        {post.frontmatter.description}
                    </p>
                </li>
            ))}
        </ul>
    </div>
</Layout>

<style>
@reference "../styles/global.css";

.posts  {
    @apply px-10 py-5 bg-secondary-300 rounded-lg
}
</style>
